{%- style -%}
  .info-grid-premium {
    padding: 120px 0;
    background: #ffffff;
  }
  .grid-v2 {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 30px;
    margin-top: 60px;
  }
  .info-card-v2 {
    background: #F8FAFC;
    padding: 40px;
    border-radius: 24px;
    transition: var(--transition-ultra);
    border: 1px solid transparent;
  }
  .info-card-v2:hover {
    background: white;
    border-color: rgba(0, 71, 255, 0.1);
    box-shadow: 0 20px 40px rgba(0, 71, 255, 0.05);
    transform: translateY(-10px);
  }
  .info-icon-v2 {
    width: 50px;
    height: 50px;
    background: white;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #0047FF;
    margin-bottom: 25px;
    box-shadow: 0 5px 15px rgba(0,0,0,0.03);
  }
  .info-title-v2 {
    font-size: 20px;
    font-weight: 800;
    margin-bottom: 12px;
    color: #0F172A;
  }
  .info-text-v2 {
    font-size: 15px;
    color: #475569;
    line-height: 1.6;
  }
  .stats-banner-v2 {
    margin-top: 100px;
    background: #0F172A;
    border-radius: 32px;
    padding: 60px;
    display: flex;
    justify-content: space-around;
    color: white;
    text-align: center;
  }
  .stat-item-v2 .number {
    display: block;
    font-size: 48px;
    font-weight: 900;
    color: #00D1FF;
    margin-bottom: 10px;
  }
  .stat-item-v2 .label {
    font-size: 14px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #94A3B8;
  }
{%- endstyle -%}

<section class="info-grid-premium">
  <div class="page-width">
    <div class="section-header">
      <span class="section-label">Proven Results</span>
      <h2 class="section-title">Designed to Boost Your <br>Conversion Rate</h2>
    </div>

    <div class="grid-v2">
      <!-- Feature 1 -->
      <div class="info-card-v2">
        <div class="info-icon-v2">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
        </div>
        <h3 class="info-title-v2">Quantity Limits</h3>
        <p class="info-text-v2">Set limits on how many units a customer can pre-order. Manage your production capacity and ensure fair distribution among your customers.</p>
      </div>

      <!-- Feature 2 -->
      <div class="info-card-v2">
        <div class="info-icon-v2">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><line x1="12" y1="8" x2="12" y2="16"></line><line x1="8" y1="12" x2="16" y2="12"></line></svg>
        </div>
        <h3 class="info-title-v2">Schedule Availability</h3>
        <p class="info-text-v2">Automate your launches. Set specific dates and times for when pre-orders should start and end, giving you full control over your product lifecycle.</p>
      </div>

      <!-- Feature 3 -->
      <div class="info-card-v2">
        <div class="info-icon-v2">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
        </div>
        <h3 class="info-title-v2">One-Click Enable</h3>
        <p class="info-text-v2">No complex configurations. Enable or disable 'Pre-Order', 'Notify Me', or 'Coming Soon' for any product with a single switch in your dashboard.</p>
      </div>
    </div>

    <div class="stats-banner-v2">
      <div class="stat-item-v2">
        <span class="number">30%</span>
        <span class="label">Avg. Revenue Lift</span>
      </div>
      <div class="stat-item-v2">
        <span class="number">24/7</span>
        <span class="label">Live Expert Support</span>
      </div>
      <div class="stat-item-v2">
        <span class="number">5k+</span>
        <span class="label">Stores Optimized</span>
      </div>
      <div class="stat-item-v2">
        <span class="number">0</span>
        <span class="label">Coding Required</span>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Info Grids Premium",
  "tag": "section",
  "class": "section",
  "settings": [],
  "presets": [
    {
      "name": "Info Grids Premium"
    }
  ]
}
{% endschema %}
