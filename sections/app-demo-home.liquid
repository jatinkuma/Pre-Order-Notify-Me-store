{%- style -%}
  .app-demo-home {
    position: relative;
    overflow: hidden;
    background:
      radial-gradient(circle at 12% 10%, rgba(198, 255, 0, 0.12), transparent 22%),
      radial-gradient(circle at 84% 18%, rgba(198, 255, 0, 0.08), transparent 18%),
      linear-gradient(180deg, #111313 0%, #171919 48%, #101111 100%);
    color: #ffffff;
  }

  .app-demo-home::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.02) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.02) 1px, transparent 1px);
    background-size: 4rem 4rem;
    opacity: 0.22;
    pointer-events: none;
  }

  .app-demo-home .page-width {
    position: relative;
    z-index: 1;
    max-width: 138rem;
  }

  .app-demo-home__hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(32rem, 54rem);
    gap: 4.8rem;
    align-items: center;
    padding: 8rem 0 5rem;
  }

  .app-demo-home__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 2rem;
    color: #d9ff36;
    font-size: 1.4rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .app-demo-home__eyebrow-icon {
    display: grid;
    place-items: center;
    width: 4.8rem;
    height: 4.8rem;
    border: 1px solid rgba(198, 255, 0, 0.45);
    border-radius: 1.4rem;
    color: #d9ff36;
    background: rgba(198, 255, 0, 0.06);
    box-shadow: 0 0 24px rgba(198, 255, 0, 0.08);
  }

  .app-demo-home__title {
    max-width: 82rem;
    margin: 0 0 1.8rem;
    color: #ffffff;
    font-size: clamp(4rem, 7vw, 7.2rem);
    line-height: 0.95;
    letter-spacing: -0.06em;
  }

  .app-demo-home__title span {
    color: #d9ff36;
  }

  .app-demo-home__description {
    max-width: 75rem;
    margin: 0 0 2.6rem;
    color: rgba(255, 255, 255, 0.78);
    font-size: 1.8rem;
    line-height: 1.75;
  }

  .app-demo-home__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1.4rem;
    margin-bottom: 3rem;
  }

  .app-demo-home__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 5.5rem;
    padding: 1.4rem 2.4rem;
    border-radius: 999px;
    text-decoration: none;
    font-size: 1.5rem;
    font-weight: 700;
    transition: transform 180ms ease, box-shadow 180ms ease, background 180ms ease, color 180ms ease;
  }

  .app-demo-home__button:hover {
    transform: translateY(-2px);
  }

  .app-demo-home__button--primary {
    background: #d9ff00;
    color: #101111;
    box-shadow: 0 18px 42px rgba(198, 255, 0, 0.18);
  }

  .app-demo-home__button--secondary {
    border: 1px solid rgba(255, 255, 255, 0.12);
    background: rgba(255, 255, 255, 0.03);
    color: #ffffff;
  }

  .app-demo-home__highlights {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.2rem 2rem;
    max-width: 76rem;
  }

  .app-demo-home__highlight {
    display: flex;
    align-items: flex-start;
    gap: 1.1rem;
    color: #ffffff;
    font-size: 1.7rem;
    line-height: 1.55;
  }

  .app-demo-home__highlight svg {
    flex-shrink: 0;
    margin-top: 0.2rem;
    color: #d9ff00;
  }

  .app-demo-home__hero-visual {
    position: relative;
    min-height: 58rem;
  }

  .app-demo-home__shape {
    position: absolute;
    right: -5rem;
    bottom: 1rem;
    width: 36rem;
    height: 42rem;
    border-radius: 4rem 4rem 3rem 3rem;
    background: linear-gradient(180deg, rgba(198, 255, 0, 0.88) 0%, rgba(126, 155, 18, 0.28) 100%);
    filter: blur(0.2px);
    opacity: 0.88;
  }

  .app-demo-home__shape::before {
    content: '';
    position: absolute;
    inset: 5rem 5rem auto;
    height: 18rem;
    border-radius: 4rem 4rem 2rem 2rem;
    background: linear-gradient(180deg, rgba(198, 255, 0, 0.9) 0%, rgba(142, 175, 20, 0.4) 100%);
  }

  .app-demo-home__phone {
    position: absolute;
    right: 3rem;
    top: 1rem;
    width: 29rem;
    padding: 1.2rem;
    border-radius: 3.8rem;
    background: #2d2d2d;
    box-shadow: 0 30px 90px rgba(0, 0, 0, 0.45);
  }

  .app-demo-home__phone-inner {
    position: relative;
    padding: 3.2rem 2.2rem 2.2rem;
    border-radius: 3rem;
    background: #131515;
    min-height: 52rem;
    text-align: center;
    overflow: hidden;
  }

  .app-demo-home__phone-inner::before {
    content: '';
    position: absolute;
    top: 1.4rem;
    left: 50%;
    width: 8rem;
    height: 0.7rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.18);
    transform: translateX(-50%);
  }

  .app-demo-home__phone-image {
    width: 11rem;
    height: 14rem;
    margin: 3.8rem auto 2.4rem;
    border-radius: 2.4rem;
    background: radial-gradient(circle at 55% 48%, #f8d1dc 0%, #f4a6b8 35%, #efe8e6 75%);
    border: 1px solid rgba(255, 255, 255, 0.12);
    box-shadow: inset 0 0 0 0.8rem rgba(255, 255, 255, 0.08);
  }

  .app-demo-home__phone-title {
    margin: 0 0 0.6rem;
    color: #ffffff;
    font-size: 2.1rem;
    font-weight: 800;
    letter-spacing: -0.04em;
  }

  .app-demo-home__phone-copy {
    margin: 0 0 1rem;
    color: rgba(255, 255, 255, 0.74);
    font-size: 1.4rem;
  }

  .app-demo-home__phone-price {
    margin: 0 0 2rem;
    color: #ffffff;
    font-size: 1.8rem;
    font-weight: 700;
  }

  .app-demo-home__phone-price span {
    color: rgba(255, 255, 255, 0.68);
    font-size: 1.3rem;
    font-weight: 500;
  }

  .app-demo-home__phone-buttons {
    display: grid;
    gap: 1.2rem;
  }

  .app-demo-home__phone-pill {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 4.8rem;
    padding: 0.8rem 1.4rem;
    border-radius: 999px;
    font-size: 1.6rem;
    font-weight: 700;
  }

  .app-demo-home__phone-pill--primary {
    background: #d9ff00;
    color: #111313;
  }

  .app-demo-home__phone-pill--ghost {
    border: 1px solid rgba(255, 255, 255, 0.24);
    color: #ffffff;
    background: transparent;
  }

  .app-demo-home__section {
    padding: 2rem 0 7rem;
  }

  .app-demo-home__section-header {
    max-width: 82rem;
    margin: 0 auto 3.6rem;
    text-align: center;
  }

  .app-demo-home__label {
    display: inline-block;
    margin-bottom: 1rem;
    color: #d9ff00;
    font-size: 1.3rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .app-demo-home__heading {
    margin: 0 0 1.2rem;
    color: #ffffff;
    font-size: clamp(2.9rem, 5vw, 4.8rem);
    line-height: 1.06;
    letter-spacing: -0.05em;
  }

  .app-demo-home__subcopy {
    margin: 0;
    color: rgba(255, 255, 255, 0.72);
    font-size: 1.7rem;
    line-height: 1.75;
  }

  .app-demo-home__features {
    display: grid;
    gap: 2.4rem;
  }

  .app-demo-home__feature {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(28rem, 0.9fr);
    gap: 2.8rem;
    align-items: center;
    padding: 3rem;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 3.2rem;
    background: rgba(255, 255, 255, 0.03);
  }

  .app-demo-home__feature-copy {
    max-width: 62rem;
  }

  .app-demo-home__feature-title {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin: 0 0 1.8rem;
    color: #ffffff;
    font-size: 2.8rem;
    font-weight: 800;
    letter-spacing: -0.04em;
  }

  .app-demo-home__feature-title svg {
    color: #d9ff00;
  }

  .app-demo-home__feature-points {
    display: grid;
    gap: 1.6rem;
  }

  .app-demo-home__feature-point {
    display: flex;
    gap: 1.2rem;
    color: rgba(255, 255, 255, 0.9);
    font-size: 1.9rem;
    line-height: 1.5;
  }

  .app-demo-home__feature-point strong {
    color: #ffffff;
    font-weight: 700;
  }

  .app-demo-home__feature-point svg {
    flex-shrink: 0;
    margin-top: 0.35rem;
    color: #d9ff00;
  }

  .app-demo-home__preview {
    position: relative;
    min-height: 40rem;
  }

  .app-demo-home__dashboard {
    position: absolute;
    left: 0;
    right: 8rem;
    bottom: 0;
    padding: 1.8rem;
    border-radius: 2.4rem;
    background: #f4f4f4;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.32);
  }

  .app-demo-home__dashboard-top {
    height: 2.6rem;
    margin-bottom: 1.4rem;
    border-radius: 0.8rem;
    background: linear-gradient(90deg, #ffffff 0%, #ececec 100%);
  }

  .app-demo-home__dashboard-search {
    height: 1.8rem;
    width: 34%;
    margin-bottom: 1.4rem;
    border-radius: 999px;
    background: #e0e0e0;
  }

  .app-demo-home__dashboard-lines {
    display: grid;
    gap: 0.9rem;
  }

  .app-demo-home__dashboard-line {
    height: 3rem;
    border-radius: 0.8rem;
    background: linear-gradient(90deg, #ffffff 0%, #ebebeb 100%);
  }

  .app-demo-home__preview-phone {
    position: absolute;
    right: 0;
    top: 1rem;
    width: 20rem;
    padding: 1rem;
    border-radius: 3rem;
    background: #2f2f2f;
    box-shadow: 0 25px 70px rgba(0, 0, 0, 0.38);
  }

  .app-demo-home__preview-screen {
    padding: 2.8rem 1.6rem 1.8rem;
    border-radius: 2.3rem;
    min-height: 34rem;
    background: #151717;
    text-align: center;
  }

  .app-demo-home__preview-image {
    width: 7.8rem;
    height: 10rem;
    margin: 1rem auto 1.8rem;
    border-radius: 1.8rem;
    background: radial-gradient(circle at 55% 48%, #f8d1dc 0%, #f4a6b8 35%, #efe8e6 75%);
  }

  .app-demo-home__preview-screen h4 {
    margin: 0 0 0.6rem;
    color: #ffffff;
    font-size: 1.7rem;
    font-weight: 800;
  }

  .app-demo-home__preview-screen p {
    margin: 0 0 1.6rem;
    color: rgba(255, 255, 255, 0.74);
    font-size: 1.25rem;
  }

  .app-demo-home__preview-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-height: 4rem;
    margin-top: 1rem;
    border-radius: 999px;
    font-size: 1.35rem;
    font-weight: 700;
  }

  .app-demo-home__preview-btn--primary {
    background: #d9ff00;
    color: #111313;
  }

  .app-demo-home__preview-btn--ghost {
    border: 1px solid rgba(255, 255, 255, 0.24);
    color: #ffffff;
  }

  .app-demo-home__benefits {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 1.6rem;
  }

  .app-demo-home__benefit {
    padding: 2.2rem;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 2.4rem;
    background: rgba(255, 255, 255, 0.03);
    text-align: left;
  }

  .app-demo-home__benefit h3 {
    margin: 0 0 0.8rem;
    color: #ffffff;
    font-size: 1.9rem;
    font-weight: 800;
    letter-spacing: -0.03em;
  }

  .app-demo-home__benefit p {
    margin: 0;
    color: rgba(255, 255, 255, 0.72);
    font-size: 1.45rem;
    line-height: 1.7;
  }

  .app-demo-home__cta {
    padding: 1rem 0 8rem;
  }

  .app-demo-home__cta-box {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 2.4rem;
    align-items: center;
    padding: 3.2rem;
    border: 1px solid rgba(198, 255, 0, 0.18);
    border-radius: 3.2rem;
    background: linear-gradient(135deg, rgba(198, 255, 0, 0.12) 0%, rgba(255, 255, 255, 0.04) 58%);
  }

  .app-demo-home__cta-box h2 {
    margin: 0 0 1rem;
    color: #ffffff;
    font-size: clamp(2.8rem, 4vw, 4.4rem);
    line-height: 1.06;
    letter-spacing: -0.05em;
  }

  .app-demo-home__cta-box p {
    margin: 0;
    max-width: 76rem;
    color: rgba(255, 255, 255, 0.76);
    font-size: 1.65rem;
    line-height: 1.75;
  }

  @media screen and (max-width: 1199px) {
    .app-demo-home__benefits {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media screen and (max-width: 989px) {
    .app-demo-home__hero,
    .app-demo-home__feature,
    .app-demo-home__cta-box {
      grid-template-columns: 1fr;
    }

    .app-demo-home__hero {
      padding-top: 6rem;
    }

    .app-demo-home__hero-visual {
      min-height: 50rem;
    }

    .app-demo-home__shape {
      right: 2rem;
      width: 30rem;
      height: 34rem;
    }

    .app-demo-home__phone {
      right: auto;
      left: 50%;
      transform: translateX(-50%);
    }

    .app-demo-home__dashboard {
      right: 3rem;
    }

    .app-demo-home__benefits {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media screen and (max-width: 749px) {
    .app-demo-home__hero {
      gap: 3rem;
      padding: 4.8rem 0 4rem;
    }

    .app-demo-home__title {
      font-size: clamp(3.6rem, 12vw, 5.2rem);
    }

    .app-demo-home__description,
    .app-demo-home__subcopy {
      font-size: 1.55rem;
    }

    .app-demo-home__actions,
    .app-demo-home__highlights {
      grid-template-columns: 1fr;
      flex-direction: column;
    }

    .app-demo-home__button {
      width: 100%;
    }

    .app-demo-home__highlights {
      display: grid;
    }

    .app-demo-home__hero-visual {
      min-height: 41rem;
    }

    .app-demo-home__shape {
      width: 21rem;
      height: 24rem;
      right: 0;
    }

    .app-demo-home__shape::before {
      inset: 3rem 3rem auto;
      height: 10rem;
    }

    .app-demo-home__phone {
      width: 23rem;
      top: 0;
    }

    .app-demo-home__phone-inner {
      min-height: 42rem;
    }

    .app-demo-home__feature,
    .app-demo-home__cta-box {
      padding: 2.2rem;
    }

    .app-demo-home__feature-point {
      font-size: 1.65rem;
    }

    .app-demo-home__preview {
      min-height: 28rem;
    }

    .app-demo-home__dashboard {
      position: relative;
      right: auto;
      padding: 1.2rem;
    }

    .app-demo-home__preview-phone {
      display: none;
    }

    .app-demo-home__benefits {
      grid-template-columns: 1fr;
    }
  }
{%- endstyle -%}

<section class="app-demo-home">
  <div class="page-width">
    <div class="app-demo-home__hero">
      <div>
        <div class="app-demo-home__eyebrow">
          <span class="app-demo-home__eyebrow-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
              <path d="M6 6h15l-1.5 9H8L6 4H3"></path>
              <path d="M9 19a1 1 0 1 0 0 .01"></path>
              <path d="M18 19a1 1 0 1 0 0 .01"></path>
              <path d="M8 9h10"></path>
              <path d="M12 3v4"></path>
              <path d="M9 5h6"></path>
            </svg>
          </span>
          <span>{{ section.settings.app_name }}</span>
        </div>

        <h1 class="app-demo-home__title">
          Boost sales with smart
          <span>Pre-Order, Notify Me & Coming Soon</span>
        </h1>

        <p class="app-demo-home__description">
          {{ section.settings.description }}
        </p>

        <div class="app-demo-home__actions">
          <a class="app-demo-home__button app-demo-home__button--primary" href="{{ section.settings.primary_link }}">
            {{ section.settings.primary_label }}
          </a>
          <a class="app-demo-home__button app-demo-home__button--secondary" href="{{ section.settings.secondary_link }}">
            {{ section.settings.secondary_label }}
          </a>
        </div>

        <div class="app-demo-home__highlights">
          <div class="app-demo-home__highlight">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M4 4h8l8 8-8 8H4l8-8-8-8Z"></path></svg>
            <span>Boost sales with preorders</span>
          </div>
          <div class="app-demo-home__highlight">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M4 4h8l8 8-8 8H4l8-8-8-8Z"></path></svg>
            <span>Create hype with coming soon</span>
          </div>
          <div class="app-demo-home__highlight">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M4 4h8l8 8-8 8H4l8-8-8-8Z"></path></svg>
            <span>Engage customers with restock alerts</span>
          </div>
          <div class="app-demo-home__highlight">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M4 4h8l8 8-8 8H4l8-8-8-8Z"></path></svg>
            <span>One-click enable or disable with sales tracking</span>
          </div>
        </div>
      </div>

      <div class="app-demo-home__hero-visual">
        <div class="app-demo-home__shape"></div>
        <div class="app-demo-home__phone">
          <div class="app-demo-home__phone-inner">
            <div class="app-demo-home__phone-image"></div>
            <h3 class="app-demo-home__phone-title">Apple iphone 15</h3>
            <p class="app-demo-home__phone-copy">ESTS - testing</p>
            <p class="app-demo-home__phone-price">Rs. 69,900.00 <span>Sold out</span></p>
            <div class="app-demo-home__phone-buttons">
              <span class="app-demo-home__phone-pill app-demo-home__phone-pill--ghost">Sold out</span>
              <span class="app-demo-home__phone-pill app-demo-home__phone-pill--primary">Buy it now</span>
              <span class="app-demo-home__phone-pill app-demo-home__phone-pill--ghost">Notify Me When Available</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="app-demo-home__section" id="app-overview">
      <div class="app-demo-home__section-header">
        <span class="app-demo-home__label">About the app</span>
        <h2 class="app-demo-home__heading">Manage out-of-stock and upcoming products effortlessly.</h2>
        <p class="app-demo-home__subcopy">
          Seamlessly integrated with Shopify, {{ section.settings.app_name }} lets merchants enable pre-orders,
          notify-me flows, and coming-soon experiences while keeping the storefront clear, branded, and conversion-focused.
        </p>
      </div>

      <div class="app-demo-home__features">
        <div class="app-demo-home__feature">
          <div class="app-demo-home__feature-copy">
            <h3 class="app-demo-home__feature-title">
              <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M6 6h15l-1.5 9H8L6 4H3"></path>
                <path d="M9 19a1 1 0 1 0 0 .01"></path>
                <path d="M18 19a1 1 0 1 0 0 .01"></path>
              </svg>
              Pre-Order
            </h3>
            <div class="app-demo-home__feature-points">
              <div class="app-demo-home__feature-point">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M4 4h8l8 8-8 8H4l8-8-8-8Z"></path></svg>
                <span><strong>Pre-Order Functionality:</strong> Allow customers to pre-order out-of-stock products.</span>
              </div>
              <div class="app-demo-home__feature-point">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M4 4h8l8 8-8 8H4l8-8-8-8Z"></path></svg>
                <span><strong>Quantity Limits:</strong> Set limits on how many units a customer can pre-order.</span>
              </div>
              <div class="app-demo-home__feature-point">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M4 4h8l8 8-8 8H4l8-8-8-8Z"></path></svg>
                <span>Enable or disable the pre-order button with a single switch and schedule availability when needed.</span>
              </div>
            </div>
          </div>

          <div class="app-demo-home__preview">
            <div class="app-demo-home__dashboard">
              <div class="app-demo-home__dashboard-top"></div>
              <div class="app-demo-home__dashboard-search"></div>
              <div class="app-demo-home__dashboard-lines">
                <div class="app-demo-home__dashboard-line"></div>
                <div class="app-demo-home__dashboard-line"></div>
                <div class="app-demo-home__dashboard-line"></div>
                <div class="app-demo-home__dashboard-line"></div>
                <div class="app-demo-home__dashboard-line"></div>
                <div class="app-demo-home__dashboard-line"></div>
              </div>
            </div>
            <div class="app-demo-home__preview-phone">
              <div class="app-demo-home__preview-screen">
                <div class="app-demo-home__preview-image"></div>
                <h4>Apple iphone 15</h4>
