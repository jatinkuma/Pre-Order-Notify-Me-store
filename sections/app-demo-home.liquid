{%- style -%}
  .app-demo-home {
    position: relative;
    overflow: hidden;
    background:
      radial-gradient(circle at top left, rgba(0, 95, 255, 0.12), transparent 32%),
      radial-gradient(circle at top right, rgba(16, 185, 129, 0.14), transparent 24%),
      linear-gradient(180deg, #f7fbff 0%, #ffffff 42%, #f6f8fc 100%);
  }

  .app-demo-home .page-width {
    position: relative;
    z-index: 1;
  }

  .app-demo-home__hero {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(320px, 0.9fr);
    gap: 4.8rem;
    align-items: center;
    padding: 8rem 0 6rem;
  }

  .app-demo-home__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
    padding: 0.9rem 1.6rem;
    margin-bottom: 2rem;
    border: 1px solid rgba(15, 23, 42, 0.08);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.8);
    color: #0f5cff;
    font-size: 1.2rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .app-demo-home__eyebrow-dot {
    width: 0.8rem;
    height: 0.8rem;
    border-radius: 50%;
    background: #19c37d;
    box-shadow: 0 0 0 0.5rem rgba(25, 195, 125, 0.14);
  }

  .app-demo-home__title {
    margin: 0 0 2rem;
    color: #0f172a;
    font-size: clamp(4rem, 7vw, 7rem);
    line-height: 0.94;
    letter-spacing: -0.06em;
  }

  .app-demo-home__title span {
    display: block;
    color: #0f5cff;
  }

  .app-demo-home__description {
    max-width: 62rem;
    margin: 0 0 2.8rem;
    color: #475569;
    font-size: 1.85rem;
    line-height: 1.7;
  }

  .app-demo-home__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1.4rem;
    margin-bottom: 2.8rem;
  }

  .app-demo-home__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.8rem;
    min-height: 5.4rem;
    padding: 1.4rem 2.4rem;
    border-radius: 999px;
    text-decoration: none;
    font-size: 1.5rem;
    font-weight: 700;
    transition: transform 180ms ease, box-shadow 180ms ease, background 180ms ease, color 180ms ease;
  }

  .app-demo-home__button:hover {
    transform: translateY(-2px);
  }

  .app-demo-home__button--primary {
    background: linear-gradient(135deg, #0f5cff 0%, #1d4ed8 100%);
    color: #ffffff;
    box-shadow: 0 18px 36px rgba(15, 92, 255, 0.24);
  }

  .app-demo-home__button--secondary {
    border: 1px solid rgba(15, 23, 42, 0.1);
    background: rgba(255, 255, 255, 0.88);
    color: #0f172a;
  }

  .app-demo-home__proof {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.2rem;
  }

  .app-demo-home__proof-item {
    padding: 1.6rem;
    border: 1px solid rgba(15, 23, 42, 0.08);
    border-radius: 2rem;
    background: rgba(255, 255, 255, 0.7);
    backdrop-filter: blur(10px);
  }

  .app-demo-home__proof-label {
    display: block;
    margin-bottom: 0.4rem;
    color: #64748b;
    font-size: 1.2rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .app-demo-home__proof-value {
    color: #0f172a;
    font-size: 1.8rem;
    font-weight: 800;
    letter-spacing: -0.03em;
  }

  .app-demo-home__panel {
    position: relative;
    padding: 2.4rem;
    border: 1px solid rgba(15, 23, 42, 0.08);
    border-radius: 3.2rem;
    background: rgba(255, 255, 255, 0.92);
    box-shadow: 0 30px 80px rgba(15, 23, 42, 0.08);
  }

  .app-demo-home__panel-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 2rem;
  }

  .app-demo-home__panel-brand {
    color: #0f172a;
    font-size: 1.4rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .app-demo-home__panel-badge {
    padding: 0.8rem 1.2rem;
    border-radius: 999px;
    background: rgba(25, 195, 125, 0.12);
    color: #047857;
    font-size: 1.2rem;
    font-weight: 700;
  }

  .app-demo-home__product {
    display: grid;
    gap: 1.6rem;
  }

  .app-demo-home__product-card {
    padding: 2rem;
    border-radius: 2.4rem;
    background: linear-gradient(180deg, #eff6ff 0%, #ffffff 100%);
    border: 1px solid rgba(15, 92, 255, 0.12);
  }

  .app-demo-home__product-image {
    display: grid;
    place-items: center;
    min-height: 18rem;
    border-radius: 2rem;
    background:
      radial-gradient(circle at top, rgba(15, 92, 255, 0.16), transparent 40%),
      linear-gradient(145deg, #0f172a 0%, #1e3a8a 100%);
    color: rgba(255, 255, 255, 0.92);
  }

  .app-demo-home__product-kicker {
    display: inline-flex;
    padding: 0.6rem 1rem;
    margin: 1.6rem 0 1rem;
    border-radius: 999px;
    background: rgba(15, 92, 255, 0.1);
    color: #0f5cff;
    font-size: 1.1rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .app-demo-home__product-title {
    margin: 0 0 0.6rem;
    color: #0f172a;
    font-size: 2.2rem;
    font-weight: 800;
    letter-spacing: -0.03em;
  }

  .app-demo-home__product-copy {
    margin: 0 0 1.4rem;
    color: #64748b;
    font-size: 1.5rem;
  }

  .app-demo-home__cta-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.6rem;
    padding: 1.4rem 1.6rem;
    border-radius: 1.8rem;
    background: #ffffff;
    border: 1px solid rgba(15, 23, 42, 0.08);
  }

  .app-demo-home__price {
    color: #0f172a;
    font-size: 1.7rem;
    font-weight: 800;
  }

  .app-demo-home__price small {
    display: block;
    color: #64748b;
    font-size: 1.2rem;
    font-weight: 600;
  }

  .app-demo-home__preorder {
    padding: 1.1rem 1.8rem;
    border-radius: 999px;
    background: linear-gradient(135deg, #0f5cff 0%, #2563eb 100%);
    color: #ffffff;
    font-size: 1.4rem;
    font-weight: 700;
  }

  .app-demo-home__notify-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.2rem;
  }

  .app-demo-home__notify-card {
    padding: 1.6rem;
    border-radius: 2rem;
    background: #ffffff;
    border: 1px solid rgba(15, 23, 42, 0.08);
  }

  .app-demo-home__notify-card strong {
    display: block;
    margin-bottom: 0.5rem;
    color: #0f172a;
    font-size: 1.4rem;
  }

  .app-demo-home__notify-card span {
    color: #64748b;
    font-size: 1.3rem;
    line-height: 1.5;
  }

  .app-demo-home__section {
    padding: 2rem 0 7rem;
  }

  .app-demo-home__section-header {
    max-width: 74rem;
    margin: 0 auto 3.2rem;
    text-align: center;
  }

  .app-demo-home__label {
    display: inline-block;
    margin-bottom: 1.2rem;
    color: #0f5cff;
    font-size: 1.2rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .app-demo-home__heading {
    margin: 0 0 1.2rem;
    color: #0f172a;
    font-size: clamp(2.8rem, 4.8vw, 4.6rem);
    line-height: 1.06;
    letter-spacing: -0.05em;
  }

  .app-demo-home__subcopy {
    margin: 0;
    color: #64748b;
    font-size: 1.7rem;
    line-height: 1.7;
  }

  .app-demo-home__feature-grid,
  .app-demo-home__benefit-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2rem;
  }

  .app-demo-home__feature-card,
  .app-demo-home__benefit-card {
    height: 100%;
    padding: 2.8rem;
    border: 1px solid rgba(15, 23, 42, 0.08);
    border-radius: 2.8rem;
    background: rgba(255, 255, 255, 0.82);
    box-shadow: 0 18px 40px rgba(15, 23, 42, 0.04);
  }

  .app-demo-home__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 5.6rem;
    height: 5.6rem;
    margin-bottom: 1.8rem;
    border-radius: 1.8rem;
    background: linear-gradient(135deg, rgba(15, 92, 255, 0.12) 0%, rgba(25, 195, 125, 0.14) 100%);
    color: #0f5cff;
  }

  .app-demo-home__card-title {
    margin: 0 0 1rem;
    color: #0f172a;
    font-size: 2rem;
    font-weight: 800;
    letter-spacing: -0.03em;
  }

  .app-demo-home__card-text {
    margin: 0;
    color: #64748b;
    font-size: 1.5rem;
    line-height: 1.7;
  }

  .app-demo-home__workflow {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2rem;
    counter-reset: app-demo-steps;
  }

  .app-demo-home__step {
    position: relative;
    padding: 2.8rem;
    border-radius: 2.8rem;
    background: #0f172a;
    color: #e2e8f0;
    overflow: hidden;
  }

  .app-demo-home__step::before {
    counter-increment: app-demo-steps;
    content: "0" counter(app-demo-steps);
    position: absolute;
    top: 2rem;
    right: 2rem;
    color: rgba(255, 255, 255, 0.14);
    font-size: 4.2rem;
    font-weight: 800;
    letter-spacing: -0.06em;
  }

  .app-demo-home__step h3 {
    margin: 0 0 1rem;
    color: #ffffff;
    font-size: 2rem;
    font-weight: 800;
    letter-spacing: -0.03em;
  }

  .app-demo-home__step p {
    margin: 0;
    font-size: 1.5rem;
    line-height: 1.7;
  }

  .app-demo-home__benefit-card {
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.95) 0%, rgba(244, 247, 251, 0.96) 100%);
  }

  .app-demo-home__final {
    padding: 5rem 0 8rem;
  }

  .app-demo-home__final-box {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 2rem;
    align-items: center;
    padding: 3.2rem;
    border-radius: 3.2rem;
    background: linear-gradient(135deg, #0f172a 0%, #0f5cff 100%);
    color: #ffffff;
    box-shadow: 0 30px 80px rgba(15, 92, 255, 0.2);
  }

  .app-demo-home__final-box h2 {
    margin: 0 0 0.8rem;
    font-size: clamp(2.8rem, 4vw, 4.2rem);
    line-height: 1.05;
    letter-spacing: -0.05em;
    color: #ffffff;
  }

  .app-demo-home__final-box p {
    margin: 0;
    max-width: 64rem;
    color: rgba(255, 255, 255, 0.84);
    font-size: 1.6rem;
    line-height: 1.7;
  }

  .app-demo-home__final-box .app-demo-home__button--secondary {
    border-color: rgba(255, 255, 255, 0.18);
    background: #ffffff;
    color: #0f172a;
  }

  @media screen and (max-width: 989px) {
    .app-demo-home__hero,
    .app-demo-home__final-box,
    .app-demo-home__feature-grid,
    .app-demo-home__benefit-grid,
    .app-demo-home__workflow {
      grid-template-columns: 1fr;
    }

    .app-demo-home__proof {
      grid-template-columns: 1fr;
    }

    .app-demo-home__hero {
      padding-top: 6.2rem;
    }

    .app-demo-home__panel {
      max-width: 64rem;
      margin: 0 auto;
    }
  }

  @media screen and (max-width: 749px) {
    .app-demo-home__hero {
      gap: 3rem;
      padding: 5rem 0 4rem;
    }

    .app-demo-home__section {
      padding-bottom: 5rem;
    }

    .app-demo-home__title {
      font-size: clamp(3.4rem, 12vw, 5rem);
    }

    .app-demo-home__description,
    .app-demo-home__subcopy {
      font-size: 1.55rem;
    }

    .app-demo-home__notify-grid {
      grid-template-columns: 1fr;
    }

    .app-demo-home__panel,
    .app-demo-home__feature-card,
    .app-demo-home__benefit-card,
    .app-demo-home__step,
    .app-demo-home__final-box {
      padding: 2.2rem;
    }

    .app-demo-home__actions {
      flex-direction: column;
      align-items: stretch;
    }

    .app-demo-home__button {
      width: 100%;
    }
  }
{%- endstyle -%}

<section class="app-demo-home">
  <div class="page-width">
    <div class="app-demo-home__hero">
      <div>
        <div class="app-demo-home__eyebrow">
          <span class="app-demo-home__eyebrow-dot"></span>
          Built for Shopify product launches
        </div>
        <h1 class="app-demo-home__title">
          Turn sold-out moments
          <span>into new revenue.</span>
        </h1>
        <p class="app-demo-home__description">
          {{ section.settings.app_name }} helps merchants replace dead-end out-of-stock experiences with pre-orders,
          back-in-stock alerts, and coming-soon campaigns that keep demand moving.
        </p>
        <div class="app-demo-home__actions">
          <a class="app-demo-home__button app-demo-home__button--primary" href="{{ section.settings.primary_link }}">
            {{ section.settings.primary_label }}
          </a>
          <a class="app-demo-home__button app-demo-home__button--secondary" href="{{ section.settings.secondary_link }}">
            {{ section.settings.secondary_label }}
          </a>
        </div>
        <div class="app-demo-home__proof">
          <div class="app-demo-home__proof-item">
            <span class="app-demo-home__proof-label">Use case</span>
            <span class="app-demo-home__proof-value">Pre-order launches</span>
          </div>
          <div class="app-demo-home__proof-item">
            <span class="app-demo-home__proof-label">Supports</span>
            <span class="app-demo-home__proof-value">Notify me flows</span>
          </div>
          <div class="app-demo-home__proof-item">
            <span class="app-demo-home__proof-label">Merchant goal</span>
            <span class="app-demo-home__proof-value">Recover lost sales</span>
          </div>
        </div>
      </div>

      <div class="app-demo-home__panel">
        <div class="app-demo-home__panel-header">
          <span class="app-demo-home__panel-brand">Demo storefront</span>
          <span class="app-demo-home__panel-badge">App widgets active</span>
        </div>

        <div class="app-demo-home__product">
          <div class="app-demo-home__product-card">
            <div class="app-demo-home__product-image">
              <svg width="126" height="126" viewBox="0 0 120 120" fill="none" aria-hidden="true">
                <rect x="20" y="14" width="80" height="92" rx="24" fill="rgba(255,255,255,0.16)"/>
                <rect x="34" y="26" width="52" height="40" rx="16" fill="rgba(255,255,255,0.84)"/>
                <path d="M40 77H80" stroke="white" stroke-width="6" stroke-linecap="round"/>
                <path d="M48 89H72" stroke="white" stroke-width="6" stroke-linecap="round" opacity="0.8"/>
              </svg>
            </div>
            <span class="app-demo-home__product-kicker">Out of stock? Keep selling</span>
            <h2 class="app-demo-home__product-title">Limited Edition Launch Kit</h2>
            <p class="app-demo-home__product-copy">Swap the default sold-out state with a branded pre-order call to action.</p>
            <div class="app-demo-home__cta-row">
              <div class="app-demo-home__price">
                $89.00
                <small>Expected ship date: 7 days</small>
              </div>
              <div class="app-demo-home__preorder">Pre-order now</div>
            </div>
          </div>

          <div class="app-demo-home__notify-grid">
            <div class="app-demo-home__notify-card">
              <strong>Notify Me</strong>
              <span>Collect demand when inventory hits zero and trigger restock alerts automatically.</span>
            </div>
            <div class="app-demo-home__notify-card">
              <strong>Coming Soon</strong>
              <span>Build launch momentum before a product is available for purchase.</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="app-demo-home__section" id="app-overview">
      <div class="app-demo-home__section-header">
        <span class="app-demo-home__label">About the app</span>
        <h2 class="app-demo-home__heading">One app for pre-orders, restock alerts, and launch campaigns.</h2>
        <p class="app-demo-home__subcopy">
          This demo store is designed for your Shopify App Store visitors to quickly understand what the app does,
          where it appears on the storefront, and why merchants use it.
        </p>
      </div>

      <div class="app-demo-home__feature-grid">
        <div class="app-demo-home__feature-card">
          <div class="app-demo-home__icon">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"></path>
              <path d="M3 6h18"></path>
              <path d="M16 10a4 4 0 0 1-8 0"></path>
            </svg>
          </div>
          <h3 class="app-demo-home__card-title">Pre-order with confidence</h3>
          <p class="app-demo-home__card-text">
            Let customers check out even when stock is unavailable, while you control messaging, expected availability,
            and quantity limits.
          </p>
        </div>

        <div class="app-demo-home__feature-card">
          <div class="app-demo-home__icon">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
              <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
            </svg>
          </div>
          <h3 class="app-demo-home__card-title">Recover intent with alerts</h3>
          <p class="app-demo-home__card-text">
            Show a polished notify-me button and capture subscribers who want to be first when inventory returns.
          </p>
        </div>

        <div class="app-demo-home__feature-card">
          <div class="app-demo-home__icon">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <rect x="3" y="4" width="18" height="18" rx="2"></rect>
              <path d="M16 2v4"></path>
              <path d="M8 2v4"></path>
              <path d="M3 10h18"></path>
            </svg>
          </div>
          <h3 class="app-demo-home__card-title">Create launch hype</h3>
          <p class="app-demo-home__card-text">
            Launch upcoming drops with coming-soon messaging so visitors stay engaged before inventory goes live.
          </p>
        </div>
      </div>
    </div>

    <div class="app-demo-home__section" id="how-it-works">
      <div class="app-demo-home__section-header">
        <span class="app-demo-home__label">How it works</span>
        <h2 class="app-demo-home__heading">A simple storefront flow merchants can understand at a glance.</h2>
        <p class="app-demo-home__subcopy">
          For a demo store, clarity matters more than complexity. This homepage now shows the exact merchant journey:
          enable the app, replace sold-out friction, and convert demand.
        </p>
      </div>

      <div class="app-demo-home__workflow">
        <div class="app-demo-home__step">
          <h3>Enable the widget</h3>
          <p>Choose pre-order, notify me, or coming soon for selected products and collections in just a few clicks.</p>
        </div>
        <div class="app-demo-home__step">
          <h3>Customize the message</h3>
          <p>Match your storefront with branded button text, availability notes, and launch-focused customer messaging.</p>
        </div>
        <div class="app-demo-home__step">
          <h3>Capture revenue and demand</h3>
          <p>Keep shoppers engaged instead of losing them at the sold-out state, then follow up automatically after restock.</p>
        </div>
      </div>
    </div>

    <div class="app-demo-home__section" id="merchant-benefits">
      <div class="app-demo-home__section-header">
        <span class="app-demo-home__label">Why merchants use it</span>
        <h2 class="app-demo-home__heading">Designed to feel useful in real storefronts, not just in a feature list.</h2>
      </div>

      <div class="app-demo-home__benefit-grid">
        <div class="app-demo-home__benefit-card">
          <h3 class="app-demo-home__card-title">Keep product pages converting</h3>
          <p class="app-demo-home__card-text">Replace default dead ends with actions customers can actually take right now.</p>
        </div>
        <div class="app-demo-home__benefit-card">
          <h3 class="app-demo-home__card-title">Show the app in context</h3>
          <p class="app-demo-home__card-text">Your App Store reviewers and prospects can immediately understand the storefront impact.</p>
        </div>
        <div class="app-demo-home__benefit-card">
          <h3 class="app-demo-home__card-title">Support launch-heavy brands</h3>
          <p class="app-demo-home__card-text">Ideal for limited drops, seasonal restocks, and brands managing demand around inventory gaps.</p>
        </div>
      </div>
    </div>

    <div class="app-demo-home__final">
      <div class="app-demo-home__final-box">
        <div>
          <h2>Ready to show merchants how your app improves sold-out products?</h2>
          <p>
            This homepage is now structured like an app demo landing page: clearer positioning, stronger storytelling,
            and sections that explain the value of {{ section.settings.app_name }} without making visitors hunt for it.
          </p>
        </div>
        <a class="app-demo-home__button app-demo-home__button--secondary" href="{{ section.settings.primary_link }}">
          {{ section.settings.primary_label }}
        </a>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "App Demo Home",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "app_name",
      "label": "App name",
      "default": "ESTS PreOrder | Notify Me"
    },
    {
      "type": "text",
      "id": "primary_label",
      "label": "Primary button label",
      "default": "Install app"
    },
    {
      "type": "url",
      "id": "primary_link",
      "label": "Primary button link"
    },
