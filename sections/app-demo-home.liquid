{% schema %}
{
  "name": "App Demo Home",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "app_name",
      "label": "App name",
      "default": "ESTS PreOrder | Notify"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "App description",
      "default": "Boost Sales with Smart Pre-Order, Notify Me & Coming Soon Features. Our app helps you manage out-of-stock and upcoming products effortlessly. Enable Pre-Order to let customers buy unavailable items in advance, set quantity limits, and schedule availability. Use Notify Me to send automatic restock alerts and keep customers engaged. Activate Coming Soon to generate excitement for new arrivals."
    },
    {
      "type": "text",
      "id": "primary_label",
      "label": "Primary button label",
      "default": "Install app"
    },
    {
      "type": "url",
      "id": "primary_link",
      "label": "Primary button link"
    },
    {
      "type": "text",
      "id": "secondary_label",
      "label": "Secondary button label",
      "default": "Explore features"
    },
    {
      "type": "url",
      "id": "secondary_link",
      "label": "Secondary button link"
    }
  ],
  "presets": [
    {
      "name": "App Demo Home"
    }
  ]
}
{% endschema %}
