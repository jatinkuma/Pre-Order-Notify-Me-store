{%- style -%}
  .header-wrapper {
    position: sticky !important;
    top: 0 !important;
    z-index: 50 !important;
    padding: 1.4rem 0 !important;
    background: rgba(255, 255, 255, 0.82) !important;
    backdrop-filter: blur(18px) !important;
    border-bottom: 1px solid rgba(15, 23, 42, 0.06) !important;
  }

  .header {
    display: flex !important;
    align-items: center !important;
    justify-content: space-between !important;
    gap: 2rem !important;
    max-width: var(--page-width) !important;
    margin: 0 auto !important;
    padding: 0 2rem !important;
  }

  .header__brand {
    display: inline-flex !important;
    align-items: center !important;
    gap: 1.2rem !important;
    text-decoration: none !important;
  }

  .header__brand-mark {
    display: grid !important;
    place-items: center !important;
    width: 4.4rem !important;
    height: 4.4rem !important;
    border-radius: 1.4rem !important;
    background: transparent !important;
    overflow: hidden !important;
    box-shadow: 0 14px 28px rgba(242, 175, 0, 0.18) !important;
  }

  .header__brand-mark img {
    display: block !important;
    width: 100% !important;
    height: 100% !important;
    object-fit: cover !important;
    border-radius: 1.4rem !important;
  }

  .header__brand-copy {
    display: flex !important;
    flex-direction: column !important;
    gap: 0.2rem !important;
  }

  .header__brand-title {
    color: #0f172a !important;
    font-size: 1.6rem !important;
    font-weight: 800 !important;
    letter-spacing: -0.03em !important;
    line-height: 1 !important;
  }

  .header__brand-subtitle {
    color: #64748b !important;
    font-size: 1.2rem !important;
    font-weight: 600 !important;
    text-transform: uppercase !important;
    letter-spacing: 0.08em !important;
    line-height: 1.2 !important;
  }

  .header__navigation {
    flex: 1 1 auto !important;
    display: flex !important;
    justify-content: center !important;
  }

  .header__menu-list {
    display: flex !important;
    align-items: center !important;
    gap: 2.4rem !important;
    list-style: none !important;
    margin: 0 !important;
    padding: 0 !important;
  }

  .header__menu-item {
    color: #334155 !important;
    text-decoration: none !important;
    font-size: 1.45rem !important;
    font-weight: 700 !important;
    transition: color 180ms ease !important;
  }

  .header__menu-item:hover {
    color: #0f5cff !important;
  }

  .header__actions {
    display: flex !important;
    align-items: center !important;
    gap: 1.2rem !important;
  }

  .header__demo-pill {
    display: inline-flex !important;
    align-items: center !important;
    gap: 0.8rem !important;
    padding: 1rem 1.4rem !important;
    border-radius: 999px !important;
    background: rgba(15, 92, 255, 0.08) !important;
    color: #0f5cff !important;
    font-size: 1.2rem !important;
    font-weight: 700 !important;
    text-transform: uppercase !important;
    letter-spacing: 0.08em !important;
  }

  .header__demo-pill::before {
    content: '';
    width: 0.8rem;
    height: 0.8rem;
    border-radius: 50%;
    background: #19c37d;
    box-shadow: 0 0 0 0.4rem rgba(25, 195, 125, 0.12);
  }

  .header__install-btn {
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    min-height: 4.8rem !important;
    padding: 1.2rem 2rem !important;
    border-radius: 999px !important;
    text-decoration: none !important;
    background: linear-gradient(135deg, #0f5cff 0%, #1d4ed8 100%) !important;
    color: #ffffff !important;
    font-size: 1.4rem !important;
    font-weight: 700 !important;
    box-shadow: 0 14px 28px rgba(15, 92, 255, 0.2) !important;
    transition: transform 180ms ease, box-shadow 180ms ease !important;
  }

  .header__contact-btn {
    position: relative !important;
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    min-height: 4.8rem !important;
    padding: 1.2rem 2rem !important;
    border: 1px solid rgba(15, 92, 255, 0.16) !important;
    border-radius: 999px !important;
    text-decoration: none !important;
    background: linear-gradient(135deg, rgba(15, 92, 255, 0.08) 0%, rgba(255, 255, 255, 0.94) 100%) !important;
    color: #0f5cff !important;
    font-size: 1.4rem !important;
    font-weight: 700 !important;
    letter-spacing: -0.01em !important;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.8), 0 10px 24px rgba(15, 92, 255, 0.08) !important;
    transition: transform 180ms ease, box-shadow 180ms ease, border-color 180ms ease, color 180ms ease !important;
  }

  .header__contact-btn::before {
    content: '' !important;
    width: 0.9rem !important;
    height: 0.9rem !important;
    margin-right: 0.8rem !important;
    border-radius: 50% !important;
    background: linear-gradient(135deg, #38bdf8 0%, #0f5cff 100%) !important;
    box-shadow: 0 0 0 0.45rem rgba(15, 92, 255, 0.08) !important;
    flex: 0 0 auto !important;
  }

  .header__contact-btn:hover {
    transform: translateY(-2px) !important;
    border-color: rgba(15, 92, 255, 0.28) !important;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.92), 0 16px 30px rgba(15, 92, 255, 0.14) !important;
    color: #0b48c7 !important;
  }

  .header__install-btn:hover {
    transform: translateY(-2px) !important;
    box-shadow: 0 18px 34px rgba(15, 92, 255, 0.24) !important;
  }

  @media screen and (max-width: 989px) {
    .header {
      flex-wrap: wrap !important;
      justify-content: space-between !important;
    }

    .header__navigation {
      order: 3 !important;
      flex: 1 0 100% !important;
      justify-content: flex-start !important;
    }

    .header__menu-list {
      flex-wrap: wrap !important;
      gap: 1.4rem !important;
    }
  }

  @media screen and (max-width: 749px) {
    .header {
      padding: 0 1.6rem !important;
    }

    .header__actions {
      width: 100% !important;
      justify-content: space-between !important;
    }

    .header__demo-pill {
      display: none !important;
    }

    .header__install-btn {
      flex: 1 1 0 !important;
    }

    .header__contact-btn {
      flex: 1 1 0 !important;
      min-width: 0 !important;
    }
  }

  @media screen and (max-width: 560px) {
    .header__actions {
      flex-direction: column !important;
      align-items: stretch !important;
    }

    .header__contact-btn,
    .header__install-btn {
      width: 100% !important;
    }
  }
{%- endstyle -%}

<header class="header-wrapper">
  <div class="header">
    <a href="/" class="header__brand" aria-label="ESTS PreOrder demo homepage">
      <span class="header__brand-mark" aria-hidden="true">
        <img
          src="{{ 'Pre-order.png' | asset_url }}"
          alt="ESTS Pre-order icon"
          loading="eager"
          width="44"
          height="44"
        >
      </span>
      <span class="header__brand-copy">
        <span class="header__brand-title">ESTS PreOrder</span>
        <span class="header__brand-subtitle">Demo store experience</span>
      </span>
    </a>

    <nav class="header__navigation" aria-label="Primary">
      <ul class="header__menu-list">
        <li><a href="/" class="header__menu-item">Home</a></li>
        <li><a href="/collections/all" class="header__menu-item">products</a></li>
        <li><a href="/#app-overview" class="header__menu-item">About app</a></li>
        <li><a href="/#how-it-works" class="header__menu-item">How it works</a></li>
      </ul>
    </nav>

    <div class="header__actions">
      <a href="https://expoundcoderz.com/contact" class="header__contact-btn" target="_blank" rel="noopener noreferrer">
        Contact Us
      </a>
      <a href="https://apps.shopify.com/ests-preorder-notify" class="header__install-btn">Install app</a>
    </div>
  </div>
</header>

